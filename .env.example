# Copy to .env for local development (never commit .env). The app needs
# nothing here to run -- every value below is optional.

# Lock CORS to your deployed frontend's origin instead of "*" once you have one
# FRONTEND_ORIGIN=https://your-app.example.com

# Serve forecasts from GitHub instead of the local data/ folder, e.g. on a
# deployment that doesn't run the scheduled refresh job itself
# PREDICTIONS_DATA_SOURCE=https://raw.githubusercontent.com/<user>/<repo>/master/data/predictions
