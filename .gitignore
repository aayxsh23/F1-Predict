# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# FastF1 and general data cache
fastf1_cache/
.fastf1/
cache/
data/cache/
*.ff1pkl

# Data pipeline (raw/processed data regenerated, not committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# data/raw/races/ is excluded by the data/raw/* rule above, so re-including
# files inside it needs the same "un-ignore the dir, then re-ignore its
# contents, then re-include the specific files" dance as src/models/saved/
# below -- git can't un-ignore a path whose PARENT DIRECTORY is excluded.
# The refresh-predictions CI job builds live features by appending one row
# to this historical table (src/models/live_predict.py's build_live_rows),
# and a fresh checkout has no re-ingestion budget (FastF1's ~500/h rate
# limit) to rebuild 105 races from scratch every 30 minutes -- commit the
# small (~2MB) per-race parquet cache so that table exists in CI at all.
!data/raw/races/
data/raw/races/*
!data/raw/races/*.parquet
# lap-by-lap stint data (~5MB), the strategy model's input -- same reason
!data/raw/laps/
data/raw/laps/*
!data/raw/laps/*.parquet
# per-team car upgrades (FIA car presentations) and pre-season testing pace,
# both small and slow to rebuild; the FIA PDFs behind them stay local
!data/raw/upgrades/
data/raw/upgrades/*
!data/raw/upgrades/*.parquet
!data/raw/testing/
data/raw/testing/*
!data/raw/testing/*.parquet

# Phase 9 chat knowledge: the Wikipedia index is big and regenerable
# (python -m src.data.wiki); data/history/ IS committed (small, and the
# Jolpica fetch behind it takes ~1.5 hours). Raw caches under data/raw/ are
# already ignored above. Training data, adapters and model files never go in git.
data/corpus/wiki_index.json
training/data/
training/out/
*.gguf

# Trained models & serialized artifacts
models/saved/
src/rag/saved/
*.joblib
*.pkl
*.pickle
*.model
*.safetensors

# src/models/saved/ ignores its own contents (not the directory itself,
# unlike the other saved/ dirs above) so the Phase 7 exception below can
# actually re-include a file inside it -- git can't un-ignore a path whose
# PARENT DIRECTORY is excluded, only a path whose parent is merely "contents
# ignored". The 4 predictor models are small (~600KB total) and a deployed
# backend needs them at process startup with no training step available --
# commit them and their metrics, keep everything else here ignored.
src/models/saved/*
!src/models/saved/*_xgb.json
!src/models/saved/pl_calibration.json
!src/models/saved/blend.json
!src/models/saved/*_metrics.json

# Notebooks
.ipynb_checkpoints/

# Testing & quality
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Build & packaging
build/
dist/
*.egg-info/

# Local Claude Code / plugin state
.claude/

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Logs
*.log
logs/

# Local-only project notes: the owner's working documents (build log, tutorial, plans,
# product notes, agent instructions). Kept on disk, never published. They are still
# read by Claude/Gemini from disk each session; they just aren't in git.
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/PRODUCT.md
/PROGRESS.md
/LEARNING.md
/phase*-plan.md
/f1-race-predictor-explainer-project-plan.md

# Design-tool exports and scratch
/Pit Wall*
*.zip
nohup.out
