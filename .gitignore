# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# FastF1 and general data cache
fastf1_cache/
.fastf1/
cache/
data/cache/
*.ff1pkl

# Data pipeline (raw/processed data regenerated, not committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained models & serialized artifacts
models/saved/
src/rag/saved/
*.joblib
*.pkl
*.pickle
*.model
*.safetensors

# src/models/saved/ ignores its own contents (not the directory itself,
# unlike the other saved/ dirs above) so the Phase 7 exception below can
# actually re-include a file inside it -- git can't un-ignore a path whose
# PARENT DIRECTORY is excluded, only a path whose parent is merely "contents
# ignored". The 4 predictor models are small (~600KB total) and a deployed
# backend needs them at process startup with no training step available --
# commit them, keep everything else here (metrics JSON, anything else) ignored.
src/models/saved/*
!src/models/saved/*_xgb.json

# Vector store (Phase 4 RAG)
chroma_db/
.chroma/

# Notebooks
.ipynb_checkpoints/

# Testing & quality
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Build & packaging
build/
dist/
*.egg-info/

# Local Claude Code / plugin state
.claude/

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Logs
*.log
logs/
